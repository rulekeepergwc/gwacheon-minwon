<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>과천 재산권 보호 민원 도우미</title>
  <meta name="description" content="과천 데이터센터 관련 문자민원 문구를 확인하고 휴대폰 문자 앱에서 직접 전송할 수 있도록 돕는 정적 웹페이지입니다.">
  <meta property="og:type" content="website">
  <meta property="og:title" content="과천 재산권 보호 민원 도우미">
  <meta property="og:description" content="문자 수신인과 발신자 유형을 선택하고 문자 앱에서 직접 내용을 확인해 전송하세요. 개인정보는 저장하지 않습니다.">
  <link rel="icon" type="image/png" sizes="512x512" href="assets/favicon.png">
  <link rel="apple-touch-icon" sizes="512x512" href="assets/favicon.png">
  <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css">
  <style>
    :root {
      --bg: #f3f6fa;
      --surface: #ffffff;
      --surface-soft: #f8fafc;
      --ink: #172033;
      --muted: #4b5565;
      --muted-soft: #6b7480;
      --line: #d7dee8;
      --line-strong: #b9c5d3;
      --primary: #153a5b;
      --primary-dark: #0d2943;
      --accent: #19715f;
      --font-sans: "Pretendard", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      --mono: var(--font-sans);
      --radius: 8px;
      --tap: 58px;
      --space-1: 4px;
      --space-2: 8px;
      --space-3: 12px;
      --space-4: 24px;
      --space-5: 24px;
      --space-6: 24px;
    }

    * { box-sizing: border-box; }
    html {
      scroll-behavior: smooth;
      -webkit-text-size-adjust: auto;
    }
    body {
      margin: 0;
      color: var(--ink);
      font-family: var(--font-sans);
      line-height: 1.7;
      word-break: keep-all;
      overflow-wrap: anywhere;
      background: var(--bg);
      -webkit-tap-highlight-color: rgba(21, 58, 91, .14);
    }
    button { font: inherit; touch-action: manipulation; }
    p, li { text-wrap: pretty; }
    h1, h2 { text-wrap: balance; }

    .page {
      width: min(720px, 100%);
      margin: 0 auto;
      padding: 0 0 56px;
      background: var(--surface);
    }
    .site-title {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 80px;
      padding: 16px 20px;
      color: #2d2d30;
      font-size: 1.5rem;
      font-weight: 700;
      line-height: 1.3;
      text-align: center;
      background: var(--surface);
    }
    .hero {
      position: relative;
      overflow: hidden;
      min-height: 520px;
      margin: 0;
      padding: 30px 32px;
      color: #ffffff;
      background-color: rgb(16, 47, 85);
      background-image: url("assets/Main-hero-bg.png");
      background-position: center bottom;
      background-size: auto 88%;
      background-repeat: no-repeat;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }
    .hero-main { position: relative; z-index: 1; min-height: 460px; }
    .hero-copy { position: relative; z-index: 2; max-width: 100%; }
    .hero h1 {
      max-width: none;
      margin: 0;
      font-size: 1.875rem;
      font-weight: 700;
      line-height: 1.27;
      letter-spacing: -.025em;
    }
    .hero p {
      max-width: 600px;
      margin: 17px 0 0;
      color: #d8e2ef;
      font-size: 1rem;
      line-height: 1.56;
    }

    .card {
      margin-bottom: var(--space-4);
      padding: 22px 18px;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: 0 8px 22px rgba(23, 32, 51, .06);
    }
    .card > h2 {
      display: flex;
      align-items: center;
      gap: 9px;
      margin: 0 0 var(--space-3);
      color: var(--ink);
      font-size: 1.125rem;
      font-weight: 700;
      line-height: 1.36;
    }
    .field {
      display: grid;
      gap: 10px;
      margin-bottom: var(--space-6);
    }
    .field-title {
      color: var(--ink);
      font-size: 1rem;
      font-weight: 600;
      line-height: 1.42;
    }
    .agency-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .agency-card {
      display: grid;
      grid-template-columns: minmax(100px, .8fr) minmax(0, 1.2fr);
      gap: var(--space-4);
      align-items: center;
      min-height: 94px;
      padding: 16px 18px;
      color: var(--ink);
      text-align: left;
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      cursor: pointer;
      box-shadow: none;
    }
    .agency-card:hover { background: var(--surface-soft); border-color: var(--ink); }
    .agency-card.is-selected {
      color: var(--surface);
      background: var(--primary);
      border-color: var(--primary-dark);
    }
    .sms-rcpt-role {
      color: var(--muted);
      font-size: .875rem;
      font-weight: 500;
      line-height: 1.4;
    }
    .sms-rcpt-copy {
      display: grid;
      gap: var(--space-1);
      min-width: 0;
      text-align: right;
    }
    .agency-name { font-size: 1.125rem; font-weight: 700; line-height: 1.3; }
    .agency-card-note { color: var(--muted-soft); font-size: .875rem; line-height: 1.42; }
    .agency-card.is-selected .sms-rcpt-role,
    .agency-card.is-selected .agency-card-note { color: #edf4fb; }

    .sender-options {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
    .sender-option {
      min-height: 48px;
      padding: 10px 6px;
      color: var(--primary);
      font-size: .875rem;
      font-weight: 700;
      line-height: 1.28;
      background: var(--surface);
      border: 1px solid var(--line-strong);
      border-radius: var(--radius);
      cursor: pointer;
      box-shadow: none;
    }
    .sender-option.is-active {
      color: var(--surface);
      background: var(--primary);
      border-color: var(--primary);
    }

    .sms-compose-title { margin-top: 0 !important; }
    .sms-preview {
      margin: 0;
      padding: 14px 13px;
      background: var(--surface-soft);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: none;
    }
    .sms-preview-title {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      color: var(--ink);
      font-size: .875rem;
      font-weight: 400;
      line-height: 1.4;
    }
    .sms-code { color: var(--muted-soft); font-weight: 600; }
    .sms-count {
      color: var(--muted-soft);
      font-family: var(--mono);
      font-size: .875rem;
      font-weight: 400;
      white-space: nowrap;
    }
    .sms-text {
      margin: 10px 0 0;
      color: var(--ink);
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      font-family: var(--mono);
      font-size: 1rem;
      line-height: 1.6;
    }
    .sms-actions {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
      margin-top: 14px;
    }
    button,
    .link-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: var(--tap);
      padding: 13px 15px;
      color: var(--surface);
      font-size: 1rem;
      font-weight: 600;
      line-height: 1.34;
      text-align: center;
      text-decoration: none;
      background: var(--primary);
      border: 1px solid transparent;
      border-radius: var(--radius);
      cursor: pointer;
      box-shadow: none;
    }
    button:active,
    .link-button:active { transform: translateY(1px); }
    .secondary {
      color: var(--ink);
      background: var(--surface-soft);
      border-color: var(--line-strong);
    }
    .button-icon {
      display: block;
      flex: 0 0 auto;
      width: 21px;
      height: 21px;
    }
    .send-icon {
      object-fit: contain;
      filter: brightness(0) invert(1);
    }
    .sms-note {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      margin: 18px 0 0;
      padding: 12px;
      color: var(--muted);
      font-size: 1rem;
      line-height: 1.62;
    }
    .alert-icon {
      flex: 0 0 auto;
      width: 20px;
      height: 20px;
      margin-top: 3px;
      color: var(--primary);
      stroke: currentColor;
    }
    .caution {
      width: calc(100% - 32px);
      margin: 12px auto 0;
      padding: 16px 14px;
      color: var(--muted);
      background: transparent;
      border: 0;
    }
    .caution h2 {
      margin: 0 0 10px;
      color: var(--ink);
      font-size: 1.125rem;
      font-weight: 700;
      line-height: 1.4;
    }
    .caution ul {
      margin: 0;
      padding-left: 18px;
      color: var(--muted);
      font-size: .875rem;
      line-height: 1.62;
    }
    .caution li + li { margin-top: 8px; }
    footer {
      margin-top: 18px;
      color: var(--muted-soft);
      font-size: .875rem;
      line-height: 1.5;
      text-align: center;
    }

    button:focus-visible,
    .link-button:focus-visible,
    .agency-card:focus-visible {
      outline: 3px solid rgba(54, 95, 98, .22);
      outline-offset: 2px;
    }

    @media (min-width: 560px) {
      .site-title { min-height: 112px; font-size: 1.75rem; }
      .hero { min-height: 620px; padding: 64px 64px 34px; }
      .hero h1 { font-size: 2.375rem; }
      .hero-main { min-height: 522px; }
      #sec-sms { padding: 34px 32px; }
      .sms-actions { grid-template-columns: 1fr 1fr; }
    }

    @media (max-width: 559px) {
      body { word-break: normal; overflow-wrap: anywhere; }
      p, li, h1, h2 { text-wrap: wrap; }
    }

    @media (max-width: 374px) {
      .site-title { min-height: 80px; padding: 16px 14px; font-size: 1.25rem; }
      .hero { min-height: 500px; padding: 30px 24px; }
      .hero h1 { font-size: 1.75rem; }
      .hero-main { min-height: 440px; }
      .sender-options { gap: 5px; }
      .sender-option { padding-left: 4px; padding-right: 4px; font-size: .75rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after {
        transition-duration: .01ms !important;
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
      }
    }
  </style>
</head>
<body>
  <main class="page">
    <div class="site-title">과천 재산권 보호 민원 도우미</div>

    <header class="hero">
      <div class="hero-main">
        <div class="hero-copy">
          <h1>소중한 재산권,<br>정당한 민원으로 지켜보세요</h1>
          <p>데이터센터 관련 행정절차가 법령과 공표된 기준에 따라 공정하고 신속하게 처리될 수 있도록, 민원 작성과 접수를 지원합니다.</p>
        </div>
      </div>
    </header>

    <section id="sec-sms" class="card" aria-labelledby="smsTitle">
      <h2 id="smsTitle"><span>민원 문자 내용을<br>자동으로 작성해드려요</span></h2>

      <div class="field">
        <div id="rcptLabel" class="field-title">1. 문자 수신인을 선택해주세요.</div>
        <div id="recipientGrid" class="agency-grid" role="group" aria-labelledby="rcptLabel"></div>
      </div>

      <div class="field">
        <div id="senderLabel" class="field-title">2. 발신자를 선택해주세요.</div>
        <div id="senderOptions" class="sender-options" role="group" aria-labelledby="senderLabel">
          <button type="button" class="sender-option is-active" data-sender="native" aria-pressed="true">과천 주암 원주민</button>
          <button type="button" class="sender-option" data-sender="citizen" aria-pressed="false">과천 시민</button>
        </div>
      </div>

      <h2 class="sms-compose-title">3. 문자 내용을 확인해주세요.</h2>
      <div id="smsPreviewLive" class="sms-preview" aria-live="polite" aria-atomic="true">
        <div class="sms-preview-title">
          <span id="messageCode" class="sms-code"></span>
          <span id="messageCount" class="sms-count">0자</span>
        </div>
        <p id="messageText" class="sms-text"></p>
      </div>

      <div class="sms-actions">
        <button type="button" id="refreshMessage" class="secondary" aria-label="같은 발신자 그룹의 다음 문자 문구 보기">
          <svg class="button-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M20 11a8 8 0 1 0-2.34 5.66" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M20 5v6h-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>새로고침</span>
        </button>
        <a id="sendMessage" class="link-button" href="#" aria-label="현재 문구를 문자 앱에서 열기">
          <img class="button-icon send-icon" src="assets/send-outline.svg" alt="" aria-hidden="true">
          <span>문자 보내기</span>
        </a>
      </div>

      <p class="sms-note">
        <svg class="alert-icon" aria-hidden="true" focusable="false" viewBox="0 0 18 18" fill="none">
          <path d="M9 16.5C13.1421 16.5 16.5 13.1421 16.5 9C16.5 4.85786 13.1421 1.5 9 1.5C4.85786 1.5 1.5 4.85786 1.5 9C1.5 13.1421 4.85786 16.5 9 16.5Z" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M9 6V9" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M9.09375 11.8125H9M9.1875 11.8125C9.1875 11.9161 9.10357 12 9 12C8.89643 12 8.8125 11.9161 8.8125 11.8125C8.8125 11.7089 8.89643 11.625 9 11.625C9.10357 11.625 9.1875 11.7089 9.1875 11.8125Z" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>자동 발송이 아닙니다. 버튼을 누르면 본인 휴대폰 문자 앱이 열리며, 실제 전송은 본인이 직접 확인해야 합니다. 공식적으로 공표된 연락처만 사용하고, 반복·대량 발송은 삼가 주세요.</span>
      </p>
    </section>

    <section class="caution" aria-labelledby="cautionTitle">
      <h2 id="cautionTitle">이용 시 주의사항</h2>
      <ul>
        <li>이 페이지는 문자 문구 작성을 돕는 정적 웹페이지이며, 문자를 자동 발송하지 않습니다.</li>
        <li>문자 앱에서 실제 발송 여부와 내용을 사용자가 직접 확인해 주세요.</li>
        <li>반복·대량 발송을 유도하거나 자동화하지 않으며, 허위사실·모욕·비방을 피하고 정중한 어조와 상식적 횟수를 지켜 주세요.</li>
        <li>이 페이지는 개인정보를 입력받거나 저장하지 않습니다.</li>
        <li>수신번호는 배포 전에 공식 공표 여부와 정확성을 최종 확인해 주세요.</li>
      </ul>
    </section>

    <footer>사용자의 브라우저 안에서만 동작하는 단일 HTML 페이지입니다. · 자동 발송에 사용하지 마세요.</footer>
  </main>

  <script>
    "use strict";

    /* 1. 문자 수신인 데이터
       - 화면에는 displayPhone을 표시하고 문자 링크에는 phone의 숫자만 사용합니다. */
    const RECIPIENTS = [
      { name: "황선희 의장", phone: "01082275139", displayPhone: "010-8227-5139" },
      { name: "지태훈 의원", phone: "01044291766", displayPhone: "010-4429-1766" },
      { name: "김동현 의원", phone: "01025796826", displayPhone: "010-2579-6826" },
      { name: "유부임 의원", phone: "01051868058", displayPhone: "010-5186-8058" },
      { name: "이주연 의원", phone: "01093104087", displayPhone: "010-9310-4087" },
      { name: "최지희 의원", phone: "01026614133", displayPhone: "010-2661-4133" }
    ];

    /* 2. 발신자별 문자 데이터
       - code/lengthLabel은 화면 식별용이며 text와 분리되어 문자 본문에 포함되지 않습니다. */
    const MESSAGE_GROUPS = {
      native: {
        label: "과천 주암 원주민",
        messages: [
          {
            code: "G-1",
            lengthLabel: "보통",
            text: "의원님, 과천주암 원주민 지주입니다. 주민들의 걱정을 대신 지고 계신 것을 압니다. 저희도 그 걱정이 없어지길 바랍니다. 다만 걱정을 푸는 방법은 조례 말고도 있다고 생각합니다. 저희가 제출한 전자파·소음·화재·열섬 자료를 한 번만 봐 주시고, 부족하면 무엇이 더 필요한지 말씀해 주십시오. 요구하시는 조건을 맞추겠습니다."
          },
          {
            code: "G-2",
            lengthLabel: "보통",
            text: "의원님, 저희는 의원님과 대립할 생각이 없습니다. 주민 안전이라는 목적에는 저희도 같은 편입니다. 부탁드리는 것은 순서 하나입니다. 결론을 조례로 먼저 정하기 전에, 근거를 함께 확인해 주십시오. 이격거리 수치의 산출 자료와 저희 자료를 나란히 놓으면 서로 받아들일 수 있는 안전 조건이 나옵니다. 그 자리를 만들어 주시는 분으로 기억되시길 바랍니다."
          },
          {
            code: "A-2",
            lengthLabel: "짧게",
            text: "원주민 지주입니다. 저희 편을 들어 달라는 게 아닙니다. 조례로 먼저 닫지 말고 심의 자리에서 따지게 해 달라는 부탁입니다."
          },
          {
            code: "A-3",
            lengthLabel: "보통",
            text: "의원님, 화훼 하다 땅 내주고 십 년을 기다린 사람입니다. 없던 걸 달라는 게 아니라 나라가 정해 준 용도대로 쓰게 해달라는 것뿐입니다. 부결된 안이 다시 올라온다는 말을 들으니 그 십 년이 또 흔들리는 기분입니다. 근거를 따져주신 그 원칙만 지켜 주십시오."
          },
          {
            code: "A-4",
            lengthLabel: "보통",
            text: "주암 원주민입니다. 저희도 아델스타 분들 마음을 압니다. 우리 아이들도 그 근처에서 자랍니다. 그래서 전자파·소음·화재 자료를 다 만들어 심의에 냈습니다. 어느 편을 들어 달라는 게 아니라, 양쪽이 같은 자료를 놓고 마주 앉을 자리를 열어 달라는 부탁입니다."
          }
        ]
      },
      citizen: {
        label: "과천 시민",
        messages: [
          {
            code: "B-1",
            lengthLabel: "짧게",
            text: "과천시민입니다. 어느 편도 아닙니다. 근거 없이 만든 규제는 결국 시가 소송으로 갚습니다. 신중히 봐 주셔서 감사합니다."
          },
          {
            code: "B-2",
            lengthLabel: "짧게",
            text: "동 주민입니다. 당론으로 다시 올라온다는 이야기를 들었습니다. 의원님 판단이 그대로 존중되기를 바랍니다."
          },
          {
            code: "B-3",
            lengthLabel: "짧게",
            text: "과천시민입니다. 의회가 정당의 시간표가 아니라 자료로 결정하는 모습을 오랜만에 봤습니다. 응원합니다."
          },
          {
            code: "B-4",
            lengthLabel: "보통",
            text: "의원님, 저는 데이터센터에 찬성도 반대도 아닙니다. 다만 300m라는 숫자가 어디서 나왔는지 아직 아무도 설명해주지 않는 것이 이상합니다. 그 질문을 하신 것 자체가 시민을 위한 일이었다고 생각합니다."
          },
          {
            code: "B-5",
            lengthLabel: "보통",
            text: "과천에서 아이 키우는 학부모입니다. 안전을 걱정하는 마음도, 평생 농사짓다 땅 내준 분들 사정도 둘 다 이해합니다. 그래서 한쪽만 이기는 결론이 아니라 협의가 필요하다고 봅니다. 의원님께서 그 자리를 만들어 주십시오."
          },
          {
            code: "B-6",
            lengthLabel: "보통",
            text: "시민입니다. 부결된 안이 당 차원에서 다시 검토된다는 말을 들었습니다. 사실이라면 부결이라는 결정을 없던 일로 만드는 셈입니다. 급하게 통과된 조례가 좋았던 경우를 저는 본 적이 없습니다. 처음의 판단을 지켜 주십시오."
          }
        ]
      }
    };

    /* 3. 선택 상태 */
    const state = {
      recipientIndex: 0,
      senderKey: "native",
      messageIndex: 0
    };

    const recipientGrid = document.getElementById("recipientGrid");
    const senderButtons = [...document.querySelectorAll(".sender-option")];
    const messageCode = document.getElementById("messageCode");
    const messageCount = document.getElementById("messageCount");
    const messageText = document.getElementById("messageText");
    const refreshMessage = document.getElementById("refreshMessage");
    const sendMessage = document.getElementById("sendMessage");

    function buildRecipientCards() {
      RECIPIENTS.forEach((recipient, index) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "agency-card";
        button.dataset.recipientIndex = String(index);
        button.setAttribute("aria-pressed", index === state.recipientIndex ? "true" : "false");

        const role = document.createElement("span");
        role.className = "sms-rcpt-role";
        role.textContent = "과천시의회";

        const copy = document.createElement("span");
        copy.className = "sms-rcpt-copy";

        const name = document.createElement("span");
        name.className = "agency-name";
        name.textContent = recipient.name;

        const phone = document.createElement("span");
        phone.className = "agency-card-note";
        phone.textContent = recipient.displayPhone;

        copy.append(name, phone);
        button.append(role, copy);
        recipientGrid.append(button);
      });

      recipientGrid.addEventListener("click", (event) => {
        const button = event.target.closest(".agency-card");
        if (!button) return;
        state.recipientIndex = Number(button.dataset.recipientIndex);
        updateRecipientSelection();
        renderSmsPreview();
      });
    }

    function updateRecipientSelection() {
      [...recipientGrid.querySelectorAll(".agency-card")].forEach((button, index) => {
        const isSelected = index === state.recipientIndex;
        button.classList.toggle("is-selected", isSelected);
        button.setAttribute("aria-pressed", isSelected ? "true" : "false");
      });
    }

    senderButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const senderKey = button.dataset.sender;
        if (!MESSAGE_GROUPS[senderKey]) return;
        if (senderKey !== state.senderKey) {
          state.senderKey = senderKey;
          state.messageIndex = 0;
        }
        senderButtons.forEach((senderButton) => {
          const isActive = senderButton.dataset.sender === state.senderKey;
          senderButton.classList.toggle("is-active", isActive);
          senderButton.setAttribute("aria-pressed", isActive ? "true" : "false");
        });
        renderSmsPreview();
      });
    });

    /* 4. 문자 미리보기 렌더링 */
    function renderSmsPreview() {
      const recipient = RECIPIENTS[state.recipientIndex];
      const group = MESSAGE_GROUPS[state.senderKey];
      const message = group.messages[state.messageIndex];

      messageCode.textContent = `${message.code} (${message.lengthLabel})`;
      messageCount.textContent = `${message.text.length}자`;
      messageText.textContent = message.text;
      sendMessage.href = smsHref(recipient.phone, message.text);
      sendMessage.setAttribute("aria-label", `${recipient.name}에게 현재 문구를 문자 앱에서 열기`);
    }

    /* 5. 새로고침 처리 */
    refreshMessage.addEventListener("click", () => {
      const messages = MESSAGE_GROUPS[state.senderKey].messages;
      state.messageIndex = (state.messageIndex + 1) % messages.length;
      renderSmsPreview();
    });

    /* 6. 문자 앱 실행 링크 생성 */
    function smsHref(phone, text, userAgent = navigator.userAgent) {
      const isIOS = /iPhone|iPad|iPod/i.test(userAgent);
      const separator = isIOS ? "&" : "?";
      return `sms:${phone}${separator}body=${encodeURIComponent(text)}`;
    }

    buildRecipientCards();
    updateRecipientSelection();
    renderSmsPreview();
  </script>
</body>
</html>
